# ============================================================
#  Configuración del servidor. Copiá este archivo como ".env"
#  (cp .env.example .env) y completá los valores.
#  El archivo .env NUNCA se sube a GitHub: tiene tus claves.
# ============================================================

NODE_ENV=production
PORT=3000

# ---- Base de datos MySQL / MariaDB ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=street_burger
DB_PASSWORD=poné-la-clave-del-usuario-de-la-base
DB_NAME=street_burger_db
DB_TIMEZONE=-03:00

# ---- Panel de administración ----
# DIRECCIÓN SECRETA del panel (obligatoria en producción). Que sea larga y rara: es la "puerta" del panel,
# y solo la sabés vos. El panel queda en https://tudominio.com/ESTA-DIRECCIÓN  (y /admin deja de existir).
# Generá una con:   node -e "console.log('/gestion-' + require('crypto').randomBytes(8).toString('hex'))"
ADMIN_PATH=

# Contraseña para entrar. Larga y única (mínimo 8 caracteres). En producción el servidor
# NO arranca si dejás una clave de ejemplo.
ADMIN_PASSWORD=
# Alternativa más segura: hash bcrypt en vez de la clave en texto plano
# (se genera con:  node -e "console.log(require('bcryptjs').hashSync('TU_CLAVE', 10))" )
# ADMIN_PASSWORD_HASH=

# Firma de las sesiones: un texto largo y aleatorio. Se genera con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Clave de los códigos QR de las mesas (cada QR lleva un código secreto: solo se puede pedir en mesa escaneándolo).
# Generala igual que la anterior. Una vez impresos los QR NO la cambies, o dejan de funcionar.
# (Si la dejás vacía se usa SESSION_SECRET.)
QR_SECRET=

# ---- HTTPS detrás de nginx ----
COOKIE_SECURE=true
TRUST_PROXY=true

# ---- Zona horaria y "día de negocio" ----
# A las 5 am empieza el día: las ventas de la 1 am cuentan para el día anterior.
TZ_LOCAL=America/Argentina/Buenos_Aires
HORA_CORTE_DIA=5
