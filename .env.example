# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cafeteria_db
DB_TIMEZONE=-03:00

# Panel de administración (/admin): elegí una contraseña larga
ADMIN_PASSWORD=cambiame-por-una-clave-larga
# Alternativa más segura: hash bcrypt en vez de la clave en texto plano
# ADMIN_PASSWORD_HASH=

# Firma de la sesión del panel (cualquier texto largo y aleatorio)
SESSION_SECRET=

PORT=3000
# Si publicás con HTTPS: COOKIE_SECURE=true y, detrás de un proxy (nginx, Render, etc.), TRUST_PROXY=true
# COOKIE_SECURE=false
# TRUST_PROXY=false

# Zona horaria de los reportes y hora a la que "empieza" el día de negocio
# (a las 5 am: las ventas de la 1 am cuentan para el día anterior)
# TZ_LOCAL=America/Argentina/Buenos_Aires
# HORA_CORTE_DIA=5
