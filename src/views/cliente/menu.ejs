<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#ffffff">
  <title><%= config.nombre_local %> · Menú</title>
  <link rel="icon" href="/img/logo-street-burger.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Inter:wght@400;500;600;700;800&family=Oswald:wght@500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/cliente.css">
  <% if (config.halloween) { %><link rel="stylesheet" href="/css/halloween.css"><% } %>
</head>
<body class="<%= config.halloween ? 'halloween' : '' %>">
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><symbol id="i-x" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></symbol><symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7"/></symbol><symbol id="i-print" viewBox="0 0 24 24"><path d="M7 9V3h10v6M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2M7 14h10v7H7z"/></symbol><symbol id="i-phone" viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></symbol><symbol id="i-pin" viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11zM12 10m-2.5 0a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0"/></symbol><symbol id="i-home" viewBox="0 0 24 24"><path d="M3 11l9-8 9 8M5 10v10h14V10"/></symbol><symbol id="i-cash" viewBox="0 0 24 24"><path d="M3 7h18v10H3zM12 12m-2.5 0a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0M6 10v4M18 10v4"/></symbol><symbol id="i-bank" viewBox="0 0 24 24"><path d="M3 10l9-6 9 6M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3 20h18"/></symbol><symbol id="i-card" viewBox="0 0 24 24"><path d="M3 6h18v12H3zM3 10h18"/></symbol><symbol id="i-bag" viewBox="0 0 24 24"><path d="M5 8h14l-1 12H6zM9 8a3 3 0 0 1 6 0"/></symbol><symbol id="i-mesa" viewBox="0 0 24 24"><path d="M7 3v8M5 3v5a2 2 0 0 0 4 0V3M7 11v10M17 3c-2 2-3 4-3 7h3v11"/></symbol><symbol id="i-chat" viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z"/></symbol><symbol id="i-download" viewBox="0 0 24 24"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"/></symbol><symbol id="i-image" viewBox="0 0 24 24"><path d="M3 5h18v14H3zM3 16l5-5 4 4 3-3 6 5M16 9.5m-1.5 0a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0-3 0"/></symbol><symbol id="i-trash" viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v6M14 11v6"/></symbol><symbol id="i-receipt" viewBox="0 0 24 24"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6"/></symbol><symbol id="i-bell" viewBox="0 0 24 24"><path d="M6 17V11a6 6 0 0 1 12 0v6l2 2H4zM10 21h4"/></symbol><symbol id="i-search" viewBox="0 0 24 24"><path d="M11 11m-7 0a7 7 0 1 0 14 0a7 7 0 1 0-14 0M20 20l-3.5-3.5"/></symbol><symbol id="i-chev" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></symbol><symbol id="i-ext" viewBox="0 0 24 24"><path d="M8 16L16 8M9 8h7v7"/></symbol></svg>
  <header class="cab">
    <span></span>
    <% if (config.halloween) { %>
    <div class="logo-flip" role="img" aria-label="<%= config.nombre_local %>">
      <div class="logo-flip-in">
        <img src="/img/logo-street-burger.png" alt="" class="logo-cab" width="76" height="76">
        <img src="/img/logo-halloween.webp" alt="" class="logo-cab dorso" width="76" height="76">
      </div>
    </div>
    <% } else { %>
    <img src="/img/logo-street-burger.png" alt="<%= config.nombre_local %>" class="logo-cab" width="76" height="76">
    <% } %>
    <div class="cab-der">
      <button class="ib" id="btnBuscar" type="button" aria-label="Buscar">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
      <button class="ib" id="btnCarritoTop" type="button" aria-label="Ver mi pedido">
        <svg viewBox="0 0 24 24"><path d="M3 4h2.5l2.2 11h10.1l2-8H6.4"/><circle cx="9.5" cy="19.5" r="1.4"/><circle cx="17" cy="19.5" r="1.4"/></svg>
        <b class="insignia" id="insignia" hidden>0</b>
      </button>
    </div>
  </header>

  <div class="buscador" id="buscador" hidden>
    <input id="q" type="search" placeholder="Buscar en el menú…" autocomplete="off" aria-label="Buscar en el menú">
  </div>

  <main class="contenedor">
    <% if (config.recibir_delivery) { %>
    <div class="modos" id="modos" role="tablist" aria-label="Tipo de pedido">
      <button type="button" class="modo activa" data-modo="mesa" role="tab"><svg class="i" aria-hidden="true"><use href="#i-mesa"/></svg> En mesa</button>
      <button type="button" class="modo" data-modo="delivery" role="tab"><svg class="i" aria-hidden="true"><use href="#i-bag"/></svg> Delivery</button>
    </div>
    <% } %>

    <div class="ubic">
      <div class="ubic-izq" id="btnMesa">
        <svg viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
        <span id="mesaTxt">Escaneá el QR de tu mesa</span>
      </div>
      <span class="ubic-der" id="ubicDer" hidden>
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        <span id="ubicDerTxt"></span>
      </span>
    </div>

    <div class="aviso" id="avisoQr" hidden></div>

    <% if (!config.recibir_pedidos) { %>
      <div class="aviso">Por ahora no tomamos pedidos desde el celular. Pedile al mozo.</div>
    <% } %>

    <a class="banner" href="#listado" id="banner" aria-label="Ver menú">
      <img src="/img/banner-street-burger.webp" alt="Street Burger – La Burguería: Coffee & Burgers" width="1400" height="466">
    </a>

    <nav class="cats" id="cats" aria-label="Categorías">
      <button type="button" class="cat activa" data-cat="todas">
        <span class="cat-icono"><img src="/img/logo-street-burger.png" alt="" width="62" height="62"></span><span class="cat-nombre">Todas</span>
      </button>
      <% categorias.forEach((c) => { %>
        <button type="button" class="cat" data-cat="<%= c.id %>">
          <% const fotoCat = c.imagen || (c.productos.find((p) => p.imagen) || {}).imagen || ""; %>
          <span class="cat-icono"><img src="<%= fotoCat || '/img/logo-street-burger.png' %>" alt="" width="62" height="62" loading="lazy"></span>
          <span class="cat-nombre"><%= c.nombre %></span>
        </button>
      <% }) %>
    </nav>

    <div id="listado">
      <% if (!categorias.length) { %><p class="vacio">El menú se está actualizando. ¡Volvé en un ratito!</p><% } %>

      <% categorias.forEach((c) => { %>
        <section class="categoria" data-cat="<%= c.id %>">
          <div class="cat-cab">
            <h2><%= c.nombre %></h2>
            <button type="button" class="ver-todas" data-ver="<%= c.id %>">Ver todas <svg class="i" aria-hidden="true"><use href="#i-chev"/></svg></button>
          </div>
          <div class="grilla">
            <% c.productos.forEach((p) => { const foto = p.imagen || c.imagen; %>
              <article class="prod" data-id="<%= p.id %>" data-txt="<%= (p.nombre + ' ' + p.descripcion + ' ' + c.nombre).toLowerCase() %>">
                <div class="prod-img<%= foto ? '' : ' sin-foto' %>">
                  <% if (foto) { %><img src="<%= foto %>" alt="<%= p.nombre %>" loading="lazy" width="96" height="96"><% } else { %><img src="/img/logo-street-burger.png" alt="" class="foto-vacia" width="96" height="96"><% } %>
                </div>
                <div class="prod-info">
                  <h3><%= p.nombre %></h3>
                  <% if (p.descripcion) { %><p class="prod-desc"><%= p.descripcion %></p><% } %>
                  <span class="prod-cat"><%= c.nombre %></span>
                </div>
                <div class="prod-lado">
                  <span class="precio"><%= formatoPrecio(p.precio) %></span>
                  <div class="control" data-control="<%= p.id %>"></div>
                </div>
              </article>
            <% }) %>
          </div>
        </section>
      <% }) %>
      <p class="vacio" id="sinResultados" hidden>No encontramos nada con esa búsqueda</p>
    </div>

    <footer class="pie">
      <p class="script">Buena compañía siempre</p>
    </footer>
  </main>

  <button class="barra-carrito" id="barraCarrito" type="button" hidden>
    <span class="bc-cant" id="bcCant">0</span>
    <span class="bc-txt">Ver mi pedido</span>
    <span class="bc-total" id="bcTotal">$0</span>
  </button>

  <nav class="tabbar" aria-label="Navegación">
    <button type="button" class="nav-item activa" id="tabInicio">
      <svg viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v10h13V10"/><path d="M10 20v-5h4v5"/></svg><span>Inicio</span>
    </button>
    <button type="button" class="nav-item" id="tabPedidos">
      <svg viewBox="0 0 24 24"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6"/></svg><span>Pedidos</span>
    </button>
    <button type="button" class="nav-item" id="tabCuenta">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg><span>Cuenta</span>
    </button>
  </nav>

  <!-- Mi pedido (carrito) -->
  <dialog id="dlgCarrito" class="hoja">
    <div class="dlg-cab"><h2>Tu pedido</h2><button class="cerrar" data-cerrar aria-label="Cerrar"><svg class="i" aria-hidden="true"><use href="#i-x"/></svg></button></div>
    <div class="para-mesa" id="paraMesa">Para la <strong id="carritoMesa">mesa</strong></div>
    <div id="carritoLista" class="lista"></div>
    <div id="datosDelivery" class="datos" hidden>
      <h3>Tus datos para la entrega</h3>
      <label class="campo"><span>Nombre</span><input id="dNombre" autocomplete="name" maxlength="60" placeholder="¿A nombre de quién?"></label>
      <label class="campo"><span>WhatsApp</span><input id="dTel" type="tel" inputmode="tel" autocomplete="tel" maxlength="24" placeholder="Ej: 11 5555 1234"></label>
      <label class="campo"><span>Dirección de entrega</span><input id="dDir" autocomplete="street-address" maxlength="150" placeholder="Calle, número y localidad"></label>
      <label class="campo"><span>Referencias <small>(opcional)</small></span><input id="dRef" maxlength="200" placeholder="Piso, timbre, entre calles…"></label>
      <div class="campo"><span>¿Cómo pagás?</span>
        <div class="pagos" id="dPagos">
          <button type="button" class="pago activa" data-pago="efectivo"><svg class="i" aria-hidden="true"><use href="#i-cash"/></svg> Efectivo</button>
          <button type="button" class="pago" data-pago="transferencia"><svg class="i" aria-hidden="true"><use href="#i-bank"/></svg> Transferencia</button>
        </div></div>
      <label class="campo" id="dPagoConBox"><span>¿Con cuánto abonás? <small>(opcional, para llevarte el vuelto)</small></span><input id="dPagoCon" type="number" inputmode="decimal" min="0" placeholder="Ej: 20000"></label>
      <p class="nota-peq" id="dTransf" hidden></p>
    </div>
    <div class="desglose" id="carritoDesglose" hidden></div>
    <div class="total-fila"><span id="totalEtq">Total de este pedido</span><strong id="carritoTotal">$0</strong></div>
    <p class="nota-peq" id="notaCarrito">Si después querés algo más, pedilo de nuevo o avisale al mozo. Pagás al final, en la mesa.</p>
    <p class="error" id="carritoError" role="alert" hidden></p>
    <button class="btn-principal" id="btnEnviar" type="button">Enviar pedido</button>
  </dialog>

  <!-- Pedido enviado -->
  <dialog id="dlgListo" class="hoja">
    <div class="listo">
      <div class="listo-ok"><svg class="i" aria-hidden="true"><use href="#i-check"/></svg></div>
      <h2>¡Pedido enviado!</h2>
      <p id="listoTxt">Ya lo recibimos.</p>
      <p class="info-transf" id="listoTransf" hidden></p>
      <button class="btn-principal" data-cerrar type="button">Seguir mirando el menú</button>
      <button class="btn-sec" id="listoCuenta" type="button">Ver mi cuenta</button>
    </div>
  </dialog>

  <!-- Mi cuenta (lo pedido en la mesa) -->
  <dialog id="dlgCuenta" class="hoja">
    <div class="dlg-cab"><h2>Mi cuenta · <span id="cuentaMesa"></span></h2><button class="cerrar" data-cerrar aria-label="Cerrar"><svg class="i" aria-hidden="true"><use href="#i-x"/></svg></button></div>
    <div id="cuentaLista" class="lista"></div>
    <div class="total-fila" id="cuentaTotalFila" hidden><span>Total hasta ahora</span><strong id="cuentaTotal">$0</strong></div>
    <p class="error" id="cuentaMsg" hidden></p>
    <div class="dos-botones" id="cuentaBotones" hidden>
      <button class="btn-principal" id="btnPedirCuenta" type="button"><svg class="i" aria-hidden="true"><use href="#i-receipt"/></svg> Pedir la cuenta</button>
      <button class="btn-sec" id="btnMozo" type="button"><svg class="i" aria-hidden="true"><use href="#i-bell"/></svg> Llamar al mozo</button>
    </div>
  </dialog>

  <!-- Cuenta / opciones -->
  <dialog id="dlgOpciones" class="hoja">
    <div class="dlg-cab"><h2>Tu cuenta</h2><button class="cerrar" data-cerrar aria-label="Cerrar"><svg class="i" aria-hidden="true"><use href="#i-x"/></svg></button></div>
    <% if (config.recibir_delivery) { %>
    <p class="op-tit">Tipo de pedido</p>
    <div class="modos modos-dlg">
      <button type="button" class="modo" data-modo="mesa"><svg class="i" aria-hidden="true"><use href="#i-mesa"/></svg> En mesa</button>
      <button type="button" class="modo" data-modo="delivery"><svg class="i" aria-hidden="true"><use href="#i-bag"/></svg> Delivery</button>
    </div>
    <% } %>
    <% if (config.direccion_local) { %><p class="op-tit">Dónde estamos</p><p class="dlg-sub"><svg class="i" aria-hidden="true"><use href="#i-pin"/></svg> <%= config.direccion_local %></p><% } %>
    <p class="op-tit">Más</p>
    <button type="button" class="op-fila" id="opBorrar" hidden><span><svg class="i" aria-hidden="true"><use href="#i-trash"/></svg> Borrar mis datos guardados</span><span aria-hidden="true">›</span></button>
  </dialog>

  <div class="toast" id="toast" role="status" hidden></div>

  <script type="application/json" id="datos"><%- JSON.stringify({
    mesas: config.cantidad_mesas,
    mesaUrl,
    tokenUrl,
    recibir: config.recibir_pedidos,
    delivery: config.recibir_delivery,
    envio: config.costo_envio,
    transferencia: config.transferencia_info,
    tiempo: config.tiempo_estimado,
    productos: Object.fromEntries(categorias.flatMap((c) => c.productos.map((p) => [p.id, { nombre: p.nombre, precio: p.precio }])))
  }).replace(/</g, "\\u003c") %></script>
  <script src="/js/cliente.js"></script>
  <% if (config.halloween) { %><script src="/js/halloween.js" defer></script><% } %>
</body>
</html>
