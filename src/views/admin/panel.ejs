<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#2a1b14">
  <title>Panel · Street Burger</title>
  <link rel="icon" href="/img/logo-street-burger.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=DM+Sans:wght@400;500;600;700&family=Oswald:wght@500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="app">
    <aside class="lateral">
      <div class="lat-marca">
        <img src="/img/logo-street-burger.jpg" alt="" class="logo" width="42" height="42">
        <div><b id="nombreLocal">Street Burger</b><small>ADMIN</small></div>
      </div>
      <nav class="nav" id="nav">
        <button data-vista="pedidos" class="activa">
          <svg viewBox="0 0 24 24"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6"/></svg><span>Pedidos</span><b class="pastilla" id="pastillaPedidos" hidden></b></button>
        <button data-vista="ventas">
          <svg viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg><span>Ventas</span></button>
        <button data-vista="menu">
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg><span>Menú</span></button>
        <button data-vista="caja">
          <svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="1"/><path d="M3 10h18M16 15h2"/></svg><span>Caja</span></button>
        <button data-vista="ajustes">
          <svg viewBox="0 0 24 24"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></svg><span>Ajustes</span></button>
      </nav>
      <div class="lat-sep"></div>
      <a class="lat-link" href="/" target="_blank" rel="noopener">Ver menú de clientes <span>↗</span></a>
      <div class="lat-usuario">
        <span class="avatar">A</span><div><b>Admin</b><small>Sesión iniciada</small></div>
        <form method="post" action="/admin/logout"><button type="submit" title="Salir" aria-label="Salir">⎋</button></form>
      </div>
    </aside>

    <main class="principal">
      <div class="aviso-sonido" id="avisoSonido" hidden>🔔 Tocá acá para activar el sonido de los pedidos nuevos</div>
      <section id="vista-pedidos" class="vista"></section>
      <section id="vista-ventas" class="vista" hidden></section>
      <section id="vista-menu" class="vista" hidden></section>
      <section id="vista-caja" class="vista" hidden></section>
      <section id="vista-ajustes" class="vista" hidden></section>
    </main>
  </div>

  <dialog id="dlgCaja"></dialog>
  <dialog id="dlgPedido" class="grande"></dialog>
  <dialog id="dlgAgregar" class="grande"></dialog>
  <dialog id="dlgCobro"></dialog>
  <dialog id="dlgTicket"></dialog>
  <dialog id="dlgForm"></dialog>

  <div id="zonaImpresion" aria-hidden="true"></div>
  <div class="toast" id="toast" role="status" hidden></div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js" defer></script>
  <script src="/js/admin.js" defer></script>
</body>
</html>
